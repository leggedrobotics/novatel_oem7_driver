<launch>

<!-- write an argument for launch_prefix -->
<arg name="launch_prefix" default=""/>


  <!-- Main Node -->
  <node name="novatel_oem7_driver_cpt7" pkg="novatel_oem7_driver"
        type="cpt7_replay_node" output="screen"
        launch-prefix="$(arg launch_prefix)"
        required="true">
      <param name="inputRosbagBasePath" value="$(find novatel_oem7_driver)/data/"/>
      <param name="inputBagName" value="inputBag.bag"/>
      <!-- Output rosbag path parameter is depcreated. It is automatically generated as the inputbag with _post_processed.bag extension -->
      <!-- <param name="outputBagName" value="inputBag_corrected.bag"/> -->

  </node>

</launch>


